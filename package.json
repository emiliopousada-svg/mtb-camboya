{
  "name": "mtb-camboya",
  "version": "1.2.7",
  "private": true,
  "description": "App de MTB: grabación de rutas, GPX y estadísticas",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.js",
    "build": "node scripts/prepare-web.js && npx cap sync android",
    "sync": "node scripts/prepare-web.js && npx cap sync android",
    "test:statistics": "node --test tests/statistics-engine.test.js",
    "test:community": "node --test tests/community-performance.test.js"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "chart.js": "4.4.1",
    "fit-file-parser": "^6.2.7",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
