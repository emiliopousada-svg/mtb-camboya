[
  {
    "id": "commroute9x2k7q",
    "name": "community_routes",
    "type": "base",
    "system": false,
    "listRule": "published = true || owner = @request.auth.id",
    "viewRule": "published = true || owner = @request.auth.id",
    "createRule": "@request.auth.id != '' && @request.body.owner = @request.auth.id && @request.body.published = true",
    "updateRule": "owner = @request.auth.id && @request.body.owner:changed = false && @request.body.published:changed = false",
    "deleteRule": "owner = @request.auth.id",
    "fields": [
      {
        "id": "commrid00000001",
        "system": true,
        "name": "id",
        "type": "text",
        "required": true,
        "primaryKey": true,
        "autogeneratePattern": "[a-z0-9]{15}",
        "min": 15,
        "max": 15,
        "pattern": "^[a-z0-9]+$"
      },
      {
        "id": "commowner000001",
        "name": "owner",
        "type": "relation",
        "required": true,
        "collectionId": "_pb_users_auth_",
        "cascadeDelete": false,
        "minSelect": 0,
        "maxSelect": 1
      },
      {
        "id": "commtitle000001",
        "name": "title",
        "type": "text",
        "required": true,
        "min": 3,
        "max": 100
      },
      {
        "id": "commprov0000001",
        "name": "province",
        "type": "text",
        "required": true,
        "min": 2,
        "max": 50
      },
      {
        "id": "commact00000001",
        "name": "activityType",
        "type": "text",
        "required": true,
        "min": 2,
        "max": 20
      },
      {
        "id": "commdist0000001",
        "name": "distanceKm",
        "type": "number",
        "required": true,
        "min": 0
      },
      {
        "id": "commascent00001",
        "name": "elevationGain",
        "type": "number",
        "required": false,
        "min": 0
      },
      {
        "id": "commtime0000001",
        "name": "movingTimeSec",
        "type": "number",
        "required": false,
        "min": 0
      },
      {
        "id": "commtrack000001",
        "name": "trackJson",
        "type": "text",
        "required": true,
        "min": 2,
        "max": 500000
      },
      {
        "id": "commpois0000001",
        "name": "poisJson",
        "type": "text",
        "required": false,
        "min": 2,
        "max": 500000
      },
      {
        "id": "commpoiphotos01",
        "name": "poiPhotos",
        "type": "file",
        "required": false,
        "maxSelect": 5,
        "maxSize": 614400,
        "mimeTypes": ["image/jpeg"],
        "protected": false
      },
      {
        "id": "commpub00000001",
        "name": "published",
        "type": "bool",
        "required": false
      }
    ],
    "indexes": [
      "CREATE INDEX `idx_community_routes_province_published` ON `community_routes` (`province`, `published`)",
      "CREATE INDEX `idx_community_routes_owner` ON `community_routes` (`owner`)"
    ]
  }
]
